# CodeLocal Rust beta (all configuration below is beta-only)
BIND_ADDR=127.0.0.1
PORT=8080
RUST_LOG=codelocal_backend=info
CODELOCAL_BACKEND_URL=http://127.0.0.1:8080
# Explicitly select the Rust beta API for native CLI pairing; no production fallback.
# CODELOCAL_BETA_API_URL=http://127.0.0.1:8080

# Test stack: docker compose -f backend/compose.beta.yml up -d --wait
# PostgreSQL + Redis must be completely separate from production.
# Set real values in shell or a git-ignored local .env; NEVER commit credentials.
# CODELOCAL_BETA_DATABASE_URL=postgres://codelocal_beta:local_beta_only_change_me@127.0.0.1:55432/codelocal_beta
# CODELOCAL_BETA_REDIS_URL=redis://127.0.0.1:56379/0
# CODELOCAL_BETA_SECURITY_BINDING_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_BYTES

# HTTPS beta URL or loopback HTTP; used in OTP emails and pairing approval URLs.
# CODELOCAL_BETA_PUBLIC_BASE_URL=http://127.0.0.1:3100

# Signup and reset emails are delivered through Resend only when fully configured.
# These are intentionally NOT the existing production RESEND_API_KEY / EMAIL_FROM vars.
# CODELOCAL_BETA_RESEND_API_KEY=REPLACE_WITH_RESEND_BETA_API_KEY
# CODELOCAL_BETA_EMAIL_FROM=CodeLocal Beta <beta@example.com>

# MMON referral onboarding is allowed only for the first explicitly configured admin.
# CODELOCAL_BETA_ADMIN_EMAILS=admin@example.com

# Ensure HTTPS sets Secure cookies if deployment is later explicitly approved.
# APP_ENV=production
