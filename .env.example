# Rust API beta (do not commit real credentials)
BIND_ADDR=127.0.0.1
PORT=8080
RUST_LOG=codelocal_backend=info

# Existing Next.js proxy destination, SERVER ONLY.
# Same-origin /api/v1/* requests are rewritten to this origin.
# Rust currently implements only bootstrap endpoints, so the old UI needs API parity work.
CODELOCAL_BACKEND_URL=http://127.0.0.1:8080
