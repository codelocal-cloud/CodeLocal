# Rust API (safe bootstrap; no production datastore defaults)
BIND_ADDR=127.0.0.1
PORT=8080
RUST_LOG=codelocal_backend=info

# Existing Next.js proxy target (server-only, no NEXT_PUBLIC_ variables)
CODELOCAL_BACKEND_URL=http://127.0.0.1:8080

# OPTIONAL: enable real beta login / account / logout with isolated LOCAL stores.
# Leave both unset to serve CSRF while auth fails closed.
# Database MUST be named *beta*; Rust never automatically runs schema migrations.
# Use a dedicated Redis instance or DB; session keys have beta-only prefixes.
# CODELOCAL_BETA_DATABASE_URL=postgres://beta_user:YOUR_PASSWORD@127.0.0.1:5432/codelocal_beta
# CODELOCAL_BETA_REDIS_URL=redis://127.0.0.1:6379/15
# CODELOCAL_BETA_SECURITY_BINDING_SECRET=SET_A_UNIQUE_RANDOM_SECRET_LONGER_THAN_32_CHARS
# CODELOCAL_BETA_ADMIN_EMAILS=

# Production cookie policy (also turns on Secure for HTTPS public origin):
# CODELOCAL_PUBLIC_BASE_URL=https://beta.codelocal.example
# APP_ENV=production
